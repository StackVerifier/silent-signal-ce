# Copy to `.env.local` (git-ignored) and fill in. Never commit a real value.
#
# Rule: anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle and
# is readable by every visitor. Credentials therefore NEVER carry that prefix —
# they are read server-side only, via `serverEnv()` in lib/env.ts.

# ─── Public — safe to expose ──────────────────────────────────────────────────
# mock: services resolve from in-memory fixtures. live: services call the API.
NEXT_PUBLIC_API_MODE=mock
# NEXT_PUBLIC_API_BASE_URL=https://api.silentsignal.io
# NEXT_PUBLIC_APP_URL=https://app.silentsignal.io

# ─── Jira Cloud ───────────────────────────────────────────────────────────────
# Two supported auth modes. Pick ONE per deployment.
#
# A) API token (Basic auth) — simplest, acts as a single service account.
#    Create at https://id.atlassian.com/manage-profile/security/api-tokens
#    Requests use: Authorization: Basic base64(JIRA_EMAIL + ':' + JIRA_API_TOKEN)
#    The token inherits that user's permissions and every read is attributed to
#    them, so use a dedicated bot account rather than a person's.
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=integration-bot@your-org.com
# JIRA_API_TOKEN=
#
# B) OAuth 2.0 (3LO) — per-user consent. Required for multi-tenant SaaS, where
#    each customer connects their own Jira site.
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# JIRA_REDIRECT_URI=https://app.silentsignal.io/api/integrations/jira/callback

# Secret Jira signs outgoing webhooks with; verify it before trusting a payload.
# JIRA_WEBHOOK_SECRET=

# ─── Slack ────────────────────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=
# An incoming webhook URL is itself a credential — anyone holding it can post.
# SLACK_WEBHOOK_URL=

# ─── Microsoft Teams ──────────────────────────────────────────────────────────
# TEAMS_WEBHOOK_URL=
# TEAMS_WEBHOOK_SECRET=

# ─── Email delivery ───────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Silent Signal <no-reply@silentsignal.io>"

# ─── Platform ─────────────────────────────────────────────────────────────────
# Signs session JWTs. Minimum 32 chars: `openssl rand -base64 32`
# SESSION_SECRET=
# DATABASE_URL=postgresql://user:password@localhost:5432/silent_signal
