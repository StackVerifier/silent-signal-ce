# ─── Public (inlined into the client bundle — never put secrets here) ─────────
# mock: services resolve from in-memory fixtures. live: services call the API.
NEXT_PUBLIC_API_MODE=mock
# NEXT_PUBLIC_API_BASE_URL=https://api.silentsignal.io
# NEXT_PUBLIC_APP_URL=https://app.silentsignal.io

# ─── Server-only (read via serverEnv(); never prefixed NEXT_PUBLIC_) ──────────
