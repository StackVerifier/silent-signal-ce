# ─── Secrets ──────────────────────────────────────────────────────────────────
# Ignore every env file, then re-allow the committed templates.
# The previous `.env*.local` pattern did NOT cover a plain `.env`, which is
# exactly where real Jira/Slack credentials end up.
.env
.env.*
!.env.example
!.env.test.example
*.pem
*.key
secrets/

# ─── Dependencies & build output ──────────────────────────────────────────────
node_modules
.pnpm-store/
.next/
out/
build/
dist/
tsconfig.tsbuildinfo
*.tsbuildinfo
.turbo/

# ─── Tooling caches ───────────────────────────────────────────────────────────
.eslintcache
coverage/
playwright-report/
test-results/
.vercel/

# ─── v0 sandbox internal files ────────────────────────────────────────────────
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/

# ─── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
